---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import MainLayout from '../layouts/MainLayout.astro';
import Divider from '../components/Divider.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const momentsFeed = (await getCollection('feed')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const feedImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/life/*.{jpeg,jpg,png,gif,webp}');
---

<MainLayout title="CS Posts and my day-to-day life :]" subtitle="i'm just sharing moments and writing about what made me love CS">
  <section class="posts">
    <div class="post-container">
      <div class="posts-table">
        <div class="table-header table-row">
          <span>DATE</span>
          <span>TAG</span>
          <span>TITLE</span>
        </div>

        <div class="table-body">
          {posts.length === 0 ? (
            <p class="empty-fallback dim-text">No posts found in directory. Standby for deployment.</p>
          ) : (
            posts.map((post) => (
              <a href={`/blog/${post.id}`} class="table-row post-link">
                <span class="dim-text">{post.data.date.toISOString().split('T')[0]}</span>
                <span class="text-blue">[{post.data.tag.toLowerCase()}]</span>
                <span class="font-bold">{post.data.title}</span>
              </a>
            ))
          )}
        </div>
      </div>
    </div>

    <Divider />

    <div class="feed">
      <div class="feed-container">
        {momentsFeed === 0 ? (
          <p class="empty-fallback dim-text">No momenst found in directory. Standby for deployment.</p>
        ): (
          momentsFeed.map((moment) => (
            <post class="stream-entry">
              <header class="entry-header">
                <span class="text-orange">[{moment.data.date.toISOString().split('T')[0]}]</span>
                <span class="dim-text"># {moment.data.tag}</span>
              </header>

              <p class="entry-text">{moment.data.description}</p>

              {moment.data.image && (
                <figure class="display-box">
                  <Image src={moment.data.image} alt={moment.data.alt} />
                </figure>
              )}
            </post>
          ))
        )}
      </div>
    </div>

  </section>
</MainLayout>

<style>
  .posts {
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .dim-text { color: var(--fg-light); }
  .text-blue { color: var(--blue, #00ffff); }
  .text-orange { color: var(--orange, #ff5f00); }
  .font-bold { font-weight: bold; }

  .posts-table {
    margin-bottom: 2rem;
  }

  .table-row {
    display: grid;
    grid-template-columns: 110px 110px 1fr;
    gap: 1rem;
    padding: 0.4rem 0.5rem;
    align-items: center;
  }

  .table-header {
    color: var(--fg-light);
    border-bottom: 1px dashed var(--bg-alt);
    font-size: 0.75rem;
    font-weight: bold;
    padding-bottom: 0.5rem;
  }

  .post-link {
    text-decoration: none;
    color: inherit;
    display: grid;
  }

  .post-link:hover {
    background-color: var(--fg, #ffffff);
    color: var(--bg, #000000);
  }

  .post-link:hover .dim-text,
  .post-link:hover .text-blue {
    color: inherit;
  }

  .empty-fallback {
    padding: 0.5rem;
    font-style: italic;
  }

  .feed-container {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr));
    gap: 2rem;
    max-width: 100%;
    margin-top: 1rem;
  }

  .stream-entry {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    border-radius: 0.3rem;
    transition: all 230ms ease;
  }

  .entry-header {
    display: flex;
    flex-direction: column;
    margin-bottom: 0.5rem;
    font-weight: bold;
  }

  .entry-text {
    color: var(--fg);
    margin-bottom: auto; 
    font-size: 0.85rem;
  }

  .display-box {
    padding: 0.75rem;
    width: 100%; 
    text-align: center;
    margin-top: 1rem;
    border-radius: 0.3rem;
  }

  .display-box img {
    width: 100%;
    aspect-ratio: 1/1;
    object-fit: cover;
    object-position: center;
    height: auto;
    display: block;
    margin-bottom: 0.5rem;
    border-radius: 0.3rem;
  }

  figcaption {
    font-size: 0.7rem;
    color: var(--fg-light);
  }

  @media (max-width: 768px) {
    .table-header {
      display: none;
    }
    
    .table-row {
      grid-template-columns: 90px 1fr;
    }

    .table-row :nth-child(2) {
      display: none;
    }

    .feed-container {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
